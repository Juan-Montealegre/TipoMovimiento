@page "/"
@inject TipoMovimientoService TipoMovimientoService

@* Pagina principal:
    - Consulta tipos de movimiento desde la API.
    - Presenta metricas y tabla ordenable.
    - Permite filtrar por texto y estado. *@
<PageTitle>Tipos de Movimiento</PageTitle>

@if (_error is not null)
{
    <div class="alert-error">
        <h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            Error de conexión
        </h3>
        <p>Ocurrió un error al consultar la API: @_error</p>
        <div class="alert-error-actions">
            <button class="btn-danger" @onclick="CargarDatosAsync">Reintentar</button>
        </div>
    </div>
}
else
{
    <div class="content-stack">
        <section class="section-intro">
            <p class="section-kicker">Resumen general</p>
            <h2>Estado actual de los movimientos</h2>
            <p class="section-copy">Visualiza rapidamente el total de registros y su distribucion por estado.</p>
        </section>

        <div class="metrics-grid">
            <div class="metric-card total-card">
                <div class="metric-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="9" x2="15" y2="9"></line><line x1="9" y1="13" x2="15" y2="13"></line><line x1="9" y1="17" x2="15" y2="17"></line></svg>
                </div>
                <div class="metric-info">
                    <span class="metric-label">Total Registros</span>
                    <span class="metric-value">
                        @if (_movimientos is null)
                        {
                            <span>--</span>
                        }
                        else
                        {
                            @_movimientos.Count
                        }
                    </span>
                </div>
            </div>

            <div class="metric-card active-card">
                <div class="metric-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <div class="metric-info">
                    <span class="metric-label">Activos</span>
                    <span class="metric-value">
                        @if (_movimientos is null)
                        {
                            <span>--</span>
                        }
                        else
                        {
                            @_movimientos.Count(m => m.VActiva)
                        }
                    </span>
                </div>
            </div>

            <div class="metric-card inactive-card">
                <div class="metric-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                </div>
                <div class="metric-info">
                    <span class="metric-label">Inactivos</span>
                    <span class="metric-value">
                        @if (_movimientos is null)
                        {
                            <span>--</span>
                        }
                        else
                        {
                            @_movimientos.Count(m => !m.VActiva)
                        }
                    </span>
                </div>
            </div>
        </div>

        <section class="data-panel">
            <div class="panel-head">
                <div>
                    <p class="section-kicker">Listado detallado</p>
                    <h3>Movimientos disponibles</h3>
                </div>
            </div>

            <div class="controls-panel">
                <div class="search-container">
                    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" class="search-input" placeholder="Buscar por descripcion o codigo..." @bind-value="_searchQuery" @bind-value:event="oninput" />
                </div>

                <div class="filters-container">
                    <select class="filter-select" @bind="_statusFilter">
                        <option value="all">Todos los estados</option>
                        <option value="active">Activos</option>
                        <option value="inactive">Inactivos</option>
                    </select>

                    <button class="btn-primary" @onclick="CargarDatosAsync">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                        Actualizar
                    </button>
                </div>
            </div>

            <div class="surface">
                @if (_movimientos is null)
                {
                    <table class="tabla-movimientos">
                        <thead>
                            <tr>
                                <th>Codigo</th>
                                <th>Descripcion</th>
                                <th>Activa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 3; i++)
                            {
                                <tr class="skeleton-row">
                                    <td><div class="skeleton-cell skeleton-badge"></div></td>
                                    <td><div class="skeleton-cell skeleton-text"></div></td>
                                    <td><div class="skeleton-cell skeleton-badge"></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (FilteredMovimientos is null || !FilteredMovimientos.Any())
                {
                    <div class="empty-state">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        <h3>No se encontraron registros</h3>
                        <p>Intenta ajustar los criterios de busqueda o filtros.</p>
                    </div>
                }
                else
                {
                    <QuickGrid Items="FilteredMovimientos" Class="tabla-movimientos">
                        <PropertyColumn Property="@(m => m.Codigo)" Title="Codigo" Sortable="true" />
                        <PropertyColumn Property="@(m => m.Descripcion)" Title="Descripcion" Sortable="true" />
                        <TemplateColumn Title="Activa" Sortable="true" SortBy="@(GridSort<TipoMovimiento>.ByAscending(m => m.VActiva))">
                            @if (context.VActiva)
                            {
                                <span class="badge badge-activo">Si</span>
                            }
                            else
                            {
                                <span class="badge badge-inactivo">No</span>
                            }
                        </TemplateColumn>
                    </QuickGrid>
                }
            </div>
        </section>
    </div>
}

@code {
    // Datos cargados desde API. Si es null, la UI muestra estado de carga.
    private List<TipoMovimiento>? _movimientos;

    // Mensaje de error para incidencias de red/configuracion.
    private string? _error;

    // Filtros de la interfaz.
    private string _searchQuery = string.Empty;
    private string _statusFilter = "all";

    // Consulta derivada para QuickGrid con filtros combinados.
    private IQueryable<TipoMovimiento>? FilteredMovimientos =>
        _movimientos?
            .Where(m => (string.IsNullOrWhiteSpace(_searchQuery) 
                         || m.Descripcion.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) 
                         || m.Codigo.ToString().Contains(_searchQuery))
                        && (_statusFilter == "all" 
                            || (_statusFilter == "active" && m.VActiva) 
                            || (_statusFilter == "inactive" && !m.VActiva)))
            .AsQueryable();

    // Hook de inicializacion del componente.
    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    // Orquesta la carga de datos y controla el estado visual (loading/error/data).
    private async Task CargarDatosAsync()
    {
        _error = null;
        _movimientos = null;
        StateHasChanged();

        try
        {
            _movimientos = await TipoMovimientoService.ObtenerTiposMovimientoAsync();
        }
        catch (Exception ex)
        {
            _error = ex.InnerException is null
                ? ex.Message
                : $"{ex.Message} - {ex.InnerException.Message}";
        }
    }
}
